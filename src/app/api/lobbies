# All endpoints here are prefixed with /game
router = APIRouter(prefix="/game", tags=["game"])

# Create game endpoint
@router.post("/create")
async def game_create(current_user: Annotated[UserPublic, Depends(get_current_user)]):
    # TODO: Check if user is in-game already (requires status)

    # Instantiate game and send it to DB
    game = Game(current_user)
    game_id = await GameRepository.createGame(game)

    # TODO: Hook up a WebSocket
    return game_id


